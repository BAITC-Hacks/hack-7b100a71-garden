# Explicit local demo mode for the synthetic dataset. Every request has HR access.
CAREER_QUEST_AUTH_DISABLED=true

# Role-separated mode: set auth_disabled=false and provide your own tokens.
# HR_API_TOKEN=replace-with-random-token
# EMPLOYEE_TOKENS_JSON={"replace-with-employee-token":"E0001"}

# Optional configuration, relative paths are resolved from the project directory.
# CAREER_QUEST_DATA_DIR=data/career_quest_dataset
# CAREER_QUEST_STATE_PATH=.runtime/state.json
# Set CAREER_QUEST_STATE_PATH to an empty string for memory-only operation.
# CAREER_QUEST_UPLOAD_MAX_BYTES=10485760
# CAREER_QUEST_RECOMMENDATION_TIMEOUT=9
# CAREER_QUEST_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CAREER_QUEST_HOST=127.0.0.1
# CAREER_QUEST_PORT=8000
